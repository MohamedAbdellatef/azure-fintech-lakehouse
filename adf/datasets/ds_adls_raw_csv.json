{
    "name": "DS_ADLS_Raw_CSV",
    "properties": {
        "linkedServiceName": {
            "referenceName": "LS_ADLS_RawLanding",
            "type": "LinkedServiceReference"
        },
        "parameters": {
            "entity": {
                "type": "string"
            },
            "load_type": {
                "type": "string"
            },
            "run_date": {
                "type": "string"
            },
            "run_id": {
                "type": "string"
            },
            "file_name": {
                "type": "string"
            }
        },
        "annotations": [],
        "type": "DelimitedText",
        "typeProperties": {
            "location": {
                "type": "AzureBlobFSLocation",
                "fileName": {
                    "value": "@dataset().file_name",
                    "type": "Expression"
                },
                "folderPath": "@concat('landing/', dataset().entity, '/', dataset().load_type, '/run_date=', dataset().run_date, '/run_id=', dataset().run_id)",
                "fileSystem": "raw"
            },
            "columnDelimiter": ",",
            "escapeChar": "\\",
            "firstRowAsHeader": true,
            "quoteChar": "\""
        },
        "schema": []
    }
}